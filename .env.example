# Projeto Supabase. Ambos os valores estao no dashboard, em
# Project Settings -> API. Sao publicos por desenho (vao no browser); o que
# protege os dados sao as politicas de seguranca ao nivel da linha definidas em
# supabase/migrations/0001_entries.sql.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# So para a area de administracao (criar contas e repor palavras-passe).
# Project Settings -> API -> service_role.
#
# ISTO E UM SEGREDO A SERIO: ignora todas as politicas de seguranca da base de
# dados. Nunca no browser, nunca num repositorio, nunca numa variavel com o
# prefixo NEXT_PUBLIC_. Sem ela a app funciona toda, menos a area de
# administracao.
SUPABASE_SERVICE_ROLE_KEY=
